{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'"
    },
    "windows": [
      {
        "height": 860,
        "label": "main",
        "minHeight": 680,
        "minWidth": 1024,
        "title": "FluxGen",
        "width": 1340
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "frontendDist": "./ui"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "longDescription": "FluxGen runs text-to-image and image-to-image generation locally through a stable-diffusion.cpp server downloaded on first run, with managed model downloads, LoRA support, presets, and a portable data folder.",
    "shortDescription": "Local image generation with GGUF Flux variants",
    "targets": [
      "nsis"
    ]
  },
  "identifier": "com.fluxgen.desktop",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/brandonmathew/FluxGen/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwM0QzMUY3MzhCREJGNTYKUldSV3Y3MDQ5ekU5NFAyY2JveHk2cXlRZUZkSVRuWlJyYit2MkJnRFIxak5uc2tWN2oraU41M2IK"
    }
  },
  "productName": "FluxGen",
  "version": "0.1.3"
}
